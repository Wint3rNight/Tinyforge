# .clangd — CUDA IntelliSense configuration for clangd
# Fixes false-positive errors in .cu files by teaching clangd about CUDA.

CompileFlags:
  # Point clangd at the build directory that holds compile_commands.json
  CompilationDatabase: build/

  # clangd can't drive nvcc; replace it with clang so it can parse CUDA itself.
  Compiler: clang++

  # Strip nvcc-only flags that clang/clangd doesn't understand, then inject
  # the flags clangd needs to understand CUDA syntax and builtins.
  Remove:
    - -forward-unknown-to-host-compiler
    - -ccbin=*
    - --options-file
    - "*.rsp"
    - --generate-code=*
    - --expt-relaxed-constexpr
    - -lineinfo
    - -rdc=*
    - -x
    - cu

  Add:
    # Tell clang this is a CUDA translation unit
    - -x
    - cuda
    # Target the same SM you build for (sm_86 = RTX 30xx / Ampere)
    - --cuda-gpu-arch=sm_86
    # *** Critical: tell clang where CUDA lives (non-standard /opt/cuda path) ***
    # Fixes: "Cannot find CUDA installation", blockIdx/threadIdx undeclared, cudaConfigureCall undeclared
    - --cuda-path=/opt/cuda
    # CUDA toolkit headers (belt-and-suspenders alongside --cuda-path)
    - -I/opt/cuda/include
    - -I/opt/cuda/targets/x86_64-linux/include
    # Suppress CUDA-specific warnings that are noisy under clangd
    - -Wno-unknown-cuda-version
    - -Wno-unused-command-line-argument

Diagnostics:
  # Suppress the noisy "argument unused during compilation" clangd warning
  Suppress:
    - unused-command-line-argument
