# .clangd — Tinyforge
#
# compile_commands.json at the project root is auto-generated by the CMake
# 'clangd_db' target (scripts/fix_compile_commands.py).  It translates all
# nvcc flags into clang-understood equivalents, so this file never needs
# to change when you add new .cu or .cpp files.
#
# To regenerate manually:  cmake --build build --target clangd_db

CompileFlags:
  CompilationDatabase: .

Diagnostics:
  Suppress:
    - unused-command-line-argument

---
# Headers in include/tinyforge/ that use CUDA APIs need CUDA context.
# This fragment is permanent — it covers all current and future .hpp files there.
If:
  PathMatch: .*/include/tinyforge/.*\.hpp$

CompileFlags:
  Compiler: clang++
  Add:
    - -x
    - cuda
    - --cuda-gpu-arch=sm_86
    - --cuda-path=/opt/cuda
    - -I/opt/cuda/include
    - -I/opt/cuda/targets/x86_64-linux/include
    - -I/home/winter/Documents/WinterInOctober/Tinyforge/include
    - -std=c++17
    - -Wno-unknown-cuda-version
    - -Wno-unused-command-line-argument
